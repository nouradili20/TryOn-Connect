# Copie ce fichier en ".env" (même dossier) et remplis la clé.
# Le fichier .env est ignoré par git : ta clé ne sera jamais versionnée.

# Clé API Decart (commence par dct_), à créer sur https://platform.decart.ai
DECART_API_KEY=
# Facultatif : port du serveur de jetons (par défaut 8787)
# PORT=8787

# Facultatif : durée max d'une session IA imposée PAR DECART, en secondes
# (garde-fou côté serveur, au-dessus du compte à rebours de l'interface ; défaut 300)
# DECART_MAX_SESSION_SECONDS=300

# Facultatif : origines web autorisées à utiliser les jetons, séparées par des virgules
# ALLOWED_ORIGINS=http://localhost:5173
